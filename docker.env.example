# Optional Docker Compose settings. Copy to .env; keep .env out of Git.
NEWBIE_PORT=8080
# For HTTPS reverse proxies, set your real origin and forward its Host header.
PUBLIC_ORIGIN=
# For compose.docker.yml only; Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0
DOCKER_WRITE_ENABLED=false
# Enable only if you trust the third-party code you install.
ALLOW_CODE_PLUGINS=false
# Optional: repository-scoped Actions token. Leave empty if not needed.
GITHUB_TOKEN=
